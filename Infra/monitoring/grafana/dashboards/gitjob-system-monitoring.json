        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{cluster=\"gitjob\",instance=~\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{cluster=\"gitjob\",instance=~\"$instance\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))",
          "legendFormat": "{{role}} / {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Root disk usage",
