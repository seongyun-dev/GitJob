# ==================================================
# Developer Intelligence Platform - .gitignore
# ==================================================

# Environment variables
.env
.env.*
!.env.example
!.env.ci.example

# Local infrastructure data and generated backups
/.local/

# Personal working documents — not shared with the team.
# New personal notes go under /docs/plans/ so they are ignored automatically.
# Team-facing docs live in docs/<part>/ and stay tracked.
/docs/plans/
/docs/shared/WORKING-RULES.md

# Worknet collection snapshots
/data/worknet/

# Saramin collection snapshots
/data/saramin/

# Scheduled-collection run history (S15P21E102-107). Operational output:
# it records what ran on one machine, not anything the team shares.
/data/collection-history.jsonl

# Temporary JobKorea collection snapshots
/data/jobkorea/

# GameJob collection snapshots
/data/gamejob/

# Spring Boot local / secret configuration
application-local.yml
application-local.yaml
application-secret.yml
application-secret.yaml
application-prod-secret.yml
application-prod-secret.yaml
