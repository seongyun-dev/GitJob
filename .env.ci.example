# Non-secret defaults for a clean Jenkins workspace.
# Jenkins copies this file to .env.ci for each build. Real credentials are
# injected through Jenkins Credentials and must not be added to this file.

COMPOSE_PROJECT_NAME=gitjob-ci-template
COMPOSE_PROFILES=core,app,data

BACKEND_IMAGE=gitjob/backend:ci
FRONTEND_IMAGE=gitjob/frontend:ci
COLLECTOR_IMAGE=gitjob/collector:ci
WORKER_IMAGE=gitjob/worker:ci
SPARK_IMAGE=gitjob/spark:ci
SPARK_BASE_IMAGE=apache/spark:3.5.3-scala2.12-java11-python3-ubuntu
HDFS_IMAGE=apache/hadoop:3.4.1

POSTGRES_DB=gitjob_ci
POSTGRES_USER=gitjob
POSTGRES_PASSWORD=ci-only-placeholder
DB_HOST=postgres
DB_PORT=5432
REDIS_HOST=redis
REDIS_PASSWORD=ci-only-placeholder

KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9094

GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
JWT_SECRET=ci-only-placeholder
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

HADOOP_CLUSTER_NAME=gitjob-ci
HDFS_URI=hdfs://hdfs-namenode:8020
HDFS_REPLICATION_FACTOR=1
PARQUET_ROOT=hdfs:///gitjob-ci/parquet
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# The split deploy wrapper pulls this ref on each EC2 host before building.
DEPLOYMENT_MODE=split
EC2_DEPLOY_REF=develop

# The split deploy wrapper pulls the selected ref and uses the repository's
# Compose files on each EC2 host. The remote env files must contain passwords,
# OAuth values, and private core/data endpoints; they are never copied from
# this CI template.
EC2_SERVICE_HOST=j15e102.p.ssafy.io
EC2_SERVICE_USER=ubuntu
EC2_SERVICE_PATH=/opt/gitjob
EC2_SERVICE_ENV_FILE=.env.service
EC2_DATA_HOST=j15e102a.p.ssafy.io
EC2_DATA_USER=ubuntu
EC2_DATA_PATH=/opt/gitjob
EC2_DATA_ENV_FILE=.env.data
EC2_SSH_PORT=22
EC2_SSH_CREDENTIAL_ID=gitjob-ec2-ssh
GITLAB_SCM_CREDENTIAL_ID=gitjob-gitlab-scm
