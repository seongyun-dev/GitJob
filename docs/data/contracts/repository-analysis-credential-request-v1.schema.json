{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitjob.local/contracts/repository-analysis-credential-request-v1.schema.json",
  "title": "RepositoryAnalysisCredentialRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_repository_id",
    "github_repository_id",
    "repository_full_name",
    "commit_sha"
  ],
  "properties": {
    "schema_version": {
      "const": "repository-analysis-credential-request/v1"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "analysis_repository_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "github_repository_id": {
      "type": "integer",
      "minimum": 1
    },
    "repository_full_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9_.-]+$"
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
