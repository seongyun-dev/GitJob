{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitjob.local/contracts/repository-analysis-credential-response-v1.schema.json",
  "title": "RepositoryAnalysisCredentialResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "data"],
  "properties": {
    "message": { "type": "string", "minLength": 1 },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "credential_type", "access_token"],
      "properties": {
        "schema_version": {
          "const": "repository-analysis-credential-response/v1"
        },
        "credential_type": {
          "const": "GITHUB_OAUTH_ACCESS_TOKEN"
        },
        "access_token": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
