# GitJob complete Compose settings
#
# WSL: ./Infra/scripts/init-wsl.sh creates .env.wsl from this template.
# EC2: copy this file to the service/data host env files and replace required
# secret/endpoint values. Never commit these env files or local data.

# -----------------------------------------------------------------------------
# Compose project and image references
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=gitjob
# Default is intentionally core only. For the complete local stack use:
# PROFILES=core,app,data,ci,observability ./Infra/scripts/up.sh
COMPOSE_PROFILES=core

# WSL and EC2 build these images from the repository checkout.
BACKEND_IMAGE=gitjob/backend:local
FRONTEND_IMAGE=gitjob/frontend:local
COLLECTOR_IMAGE=gitjob/collector:local
WORKER_IMAGE=gitjob/worker:local
JENKINS_IMAGE=gitjob/jenkins:local
JENKINS_AGENT_IMAGE=gitjob/jenkins-agent:local

# JobKorea image OCR runs only in the Collector image. Its downloaded Korean
# models share the persistent collector-state volume with the site cursors.
# The limits protect HDFS/Spark when OCR runs on the 4-vCPU data host.
PADDLE_PDX_CACHE_HOME=/data/.paddlex
PADDLE_PDX_CPU_NUM_THREADS=2
COLLECTOR_CPUS=2.0
COLLECTOR_MEMORY_LIMIT=4g

# Optional external image overrides for the data/observability services.
HDFS_IMAGE=apache/hadoop:3.4.1
# Both WSL and EC2 build Infra/docker/spark/Dockerfile from this base image.
# deploy.sh 가 빌드하는 태그(Infra/scripts/deploy.sh 의 local_spark_image)와 같아야 한다.
# 다르면 deploy.sh 를 거치지 않는 수동 compose 호출이 다른 이미지를 띄운다.
SPARK_IMAGE=gitjob/spark:local
SPARK_BASE_IMAGE=apache/spark:3.5.3-scala2.12-java11-python3-ubuntu
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
REDIS_INSIGHT_IMAGE=redis/redisinsight:2.68.0

# Monitoring overlay images are pinned so a dashboard run is reproducible.
# Start the overlay only with targeted monitoring services; do not include it
# in a full-stack restart on an already-running EC2 host.
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana:11.2.0
NODE_EXPORTER_IMAGE=prom/node-exporter:v1.8.2
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:v1.8.0
KAFKA_EXPORTER_BROKER=kafka:9092
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
# Replace this placeholder in the private host env; never commit the secret.
GRAFANA_ADMIN_PASSWORD=change-me-with-a-long-random-password
NODE_EXPORTER_BIND_ADDRESS=127.0.0.1
NODE_EXPORTER_PORT=9100

# Backend Admin Monitoring proxy (S15P21E102-209).
# The admin screen reads metrics through the Backend, not from the browser, so
# the private Prometheus address stays out of the frontend bundle.
# Leave PROMETHEUS_BASE_URL empty and the Backend does not call Prometheus at
# all: the screen renders NOT_CONFIGURED instead of zeros. Set it to the
# Prometheus origin reachable from the Backend container - on the service host
# that is the Compose service name, and off-host it is the administrator-network
# address. Do not put an administrator address in this example file.
PROMETHEUS_BASE_URL=
PROMETHEUS_TIMEOUT=3s
# Must match global.scrape_interval in Infra/monitoring/prometheus/prometheus.yml.
PROMETHEUS_SCRAPE_INTERVAL=15s
# The cluster label value from Infra/monitoring/prometheus/targets/node-exporter.yml.
PROMETHEUS_CLUSTER=gitjob
# Quick Access links the admin screen opens. Returned in the API response, never
# compiled into the frontend. Empty means the screen shows no link.
GRAFANA_ADMIN_URL=
PROMETHEUS_ADMIN_URL=

# -----------------------------------------------------------------------------
# WSL host ports (all WSL bindings are 127.0.0.1; EC2 uses its own override)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=9094
NGINX_HTTP_PORT=8080
JENKINS_HTTP_PORT=8081
JENKINS_AGENT_PORT=50000
KAFKA_UI_PORT=8082
SPARK_MASTER_WEB_PORT=8083
HDFS_NAMENODE_WEB_PORT=9870
HDFS_DATANODE_WEB_PORT=9864
REDIS_INSIGHT_PORT=8001

# EC2 public boundary: Nginx HTTP/HTTPS are published by compose.ec2.yaml. Core
# ports below are private-only bindings for the split data-node topology.
NGINX_EC2_BIND=0.0.0.0
NGINX_EC2_HTTP_PORT=80
NGINX_EC2_HTTPS_PORT=443
LETSENCRYPT_DIR=/etc/letsencrypt
CERTBOT_WEBROOT_HOST_PATH=.local/certbot/www

# Tailscale-only administrator pages. Replace the bind addresses with each
# EC2's Tailscale IPv4; keep the loopback defaults for local/non-admin use.
SERVICE_ADMIN_BIND_ADDRESS=127.0.0.1
KAFKA_UI_EC2_PORT=8082
REDIS_INSIGHT_EC2_PORT=8001
PROMETHEUS_EC2_PORT=9090
GRAFANA_EC2_PORT=3000
DATA_ADMIN_BIND_ADDRESS=127.0.0.1
SPARK_WORKER_WEB_PORT=8084

# Two-host HDFS/Spark cluster. Use each host's stable Tailscale IPv4. These
# values are mandatory only for the cluster Compose files and remain empty in
# ordinary WSL/single-host deployments.
DATA_TS_IP=
SERVICE_TS_IP=
# When a bridge-network NameNode sees the remote DataNode through Docker's
# published-port proxy, set the observed source address here for rack mapping.
# Determine it from dfsadmin -report during deployment; do not assume this value.
SERVICE_DN_REGISTRATION_IP=
CLUSTER_WORKER_PROJECT_NAME=gitjob-cluster-worker
CLUSTER_WORKER_PROFILES=hdfs-worker
HDFS_DATANODE4_HEAP_MB=768
HDFS_DATANODE4_CPUS=0.50
HDFS_DATANODE4_MEMORY_LIMIT=1536m
HDFS_DATANODE4_VOLUME_NAME=gitjob-cluster-worker-hdfs-datanode4-data
SPARK_WORKER2_CORES=1
SPARK_WORKER2_MEMORY=1G
SPARK_WORKER2_CPUS=1.0
SPARK_WORKER2_MEMORY_LIMIT=1536m
SPARK_WORKER2_OPTS=-Dspark.worker.cleanup.enabled=true

# Fixed Spark application ports used after Phase 8. They are declared now so
# Tailscale policy and collision checks can be reviewed before rollout.
# Two-host values: driver 40001, driver block manager 40002, executor block
# manager 41000 with 15 retries, executor cores 1, total cores 2.
SPARK_DRIVER_HOST=
SPARK_DRIVER_BIND_ADDRESS=
SPARK_DRIVER_PORT=
SPARK_DRIVER_BLOCK_MANAGER_PORT=
SPARK_EXECUTOR_BLOCK_MANAGER_PORT=
SPARK_PORT_MAX_RETRIES=
SPARK_EXECUTOR_CORES=
SPARK_CORES_MAX=

# HDFS replication that Spark jobs request. This is a client-side setting: the
# Spark image ships no hdfs-site.xml, so leaving it unset would fall back to
# Hadoop's built-in default of 3. In the two-host topology only one DataNode
# sits on /rack-b, so 3 replicas can never be placed and every write stays
# under-replicated. 2 is what the two racks satisfy, and it puts one replica on
# each EC2. Empty uses the script default of 2.
SPARK_HDFS_REPLICATION=
CANARY_MIN_HOSTS=2

# Split topology: the service EC2 binds these core ports to its private IP so
# the data EC2 can reach them. Keep the loopback defaults for a single-host
# deployment. The current EC2 setup does not change UFW; confirm the provided
# network boundary before exposing these bindings.
EC2_CORE_BIND_ADDRESS=127.0.0.1
EC2_POSTGRES_PORT=5432
EC2_REDIS_PORT=6379
EC2_KAFKA_EXTERNAL_PORT=9094
EC2_KAFKA_ADVERTISED_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# Deployment topology
# ----------------------------------------------------------------------------
# The current layout is split: service/core on one host and data on the other.
DEPLOYMENT_MODE=split
PUBLIC_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# PostgreSQL and Redis
# -----------------------------------------------------------------------------
POSTGRES_DB=gitjob
POSTGRES_USER=gitjob
POSTGRES_PASSWORD=change-me-with-a-long-random-password
DB_HOST=postgres
DB_PORT=5432

REDIS_HOST=redis
REDIS_PASSWORD=change-me-with-a-long-random-password

# -----------------------------------------------------------------------------
# Application connection settings
# -----------------------------------------------------------------------------
APP_ENV=docker
SPRING_PROFILES_ACTIVE=docker
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP_SERVERS=localhost:9094

# OAuth/JWT values are intentionally placeholders. Store real values in a
# local env file or Jenkins/AWS secret store; do not put them in Git.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
GITHUB_API_URL=https://api.github.com
GITHUB_API_TOKEN=
JWT_SECRET=change-me-with-a-long-random-secret
COOKIE_SECURE=false
# OAuth 콜백 결과를 안내할 FE 화면. 성공·실패 모두 이 주소로 302한다.
FRONTEND_CALLBACK_URL=http://localhost:8080/auth/callback
# 로그인 후 이동 가능한 FE 경로 화이트리스트. 목록의 첫 항목이 기본 목적지다.
# 사용자 입력이므로 여기 없는 경로는 거부한다(open redirect 방지).
OAUTH_ALLOWED_REDIRECT_PATHS=/onboarding/repositories,/repos,/
CORS_ALLOWED_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# -----------------------------------------------------------------------------
# Kafka topics and consumer groups (provisional until the event envelope is
# approved by BE/AI). AUTO_CREATE is disabled; create topics explicitly.
# -----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_TOPIC_SOURCE_EVENTS=gitjob.source.events
KAFKA_TOPIC_ANALYSIS_REQUESTS=gitjob.analysis.requests
KAFKA_TOPIC_ANALYSIS_RESULTS=gitjob.analysis.results
KAFKA_TOPIC_ANALYSIS_DLQ=gitjob.analysis.dlq
KAFKA_TOPIC_REPOSITORY_ANALYSIS_REQUESTS=gitjob.repository-analysis.requests.v1
# CDC는 Debezium이 analysis_outbox 커밋을 Kafka로 옮긴다. POLLING은 Debezium 없이
# 백엔드 스케줄러가 직접 발행하는 롤백 경로이며, 둘을 동시에 켜면 중복 발행된다.
# 분석 요청 시 이벤트에 기록할 판정 Registry 버전.
ANALYSIS_REGISTRY_VERSION=technology-registry/v1
ANALYSIS_POLL_AFTER_SECONDS=2
ANALYSIS_OUTBOX_MODE=CDC
# POLLING 모드에서만 의미가 있는 스케줄러 스위치.
ANALYSIS_OUTBOX_ENABLED=true
ANALYSIS_OUTBOX_POLL_INTERVAL=2s
ANALYSIS_OUTBOX_BATCH_SIZE=20
ANALYSIS_OUTBOX_MAX_ATTEMPTS=10
ANALYSIS_OUTBOX_SEND_TIMEOUT=10s
ANALYSIS_OUTBOX_RETRY_DELAY=5s
ANALYSIS_OUTBOX_MAX_RETRY_DELAY=5m
# --- Debezium CDC (ANALYSIS_OUTBOX_MODE=CDC일 때 필요) ---
# BE/src/main/resources/db/changes/002_analysis_outbox_cdc.sql의 __CDC_PASSWORD__와
# 같은 값이어야 한다. 애플리케이션 DB 비밀번호와 다른 값을 사용한다.
CDC_DATABASE_PASSWORD=change-me-cdc-password
DEBEZIUM_CONNECT_IMAGE=quay.io/debezium/connect:3.4.3
CDC_CONNECT_GROUP_ID=gitjob-cdc
CDC_CONFIG_STORAGE_TOPIC=gitjob.connect.configs
CDC_OFFSET_STORAGE_TOPIC=gitjob.connect.offsets
CDC_STATUS_STORAGE_TOPIC=gitjob.connect.status
CDC_OFFSET_FLUSH_INTERVAL_MS=10000
CDC_CONNECTOR_NAME=analysis-outbox
# WSL 전용 루프백 포트. 8083은 spark-master가 이미 사용한다.
CDC_CONNECT_PORT=8084
# Debezium 슬롯 + 여유분. 읽기 복제본을 붙이면 함께 올린다.
POSTGRES_MAX_REPLICATION_SLOTS=4
POSTGRES_MAX_WAL_SENDERS=4

# --- 저장소 분석 Worker (python -m analysis) ---
# C조 worker의 KAFKA_TOPIC_ANALYSIS_DLQ와 다른 토픽이다. payload 형태가 달라 섞으면 안 된다.
KAFKA_TOPIC_REPOSITORY_ANALYSIS_DLQ=gitjob.repository-analysis.dlq.v1
# Worker → BE. 성공·실패 모두 이 토픽으로 간다. DLQ는 운영자용이라,
# 실패가 거기에만 남으면 analysis_job이 영원히 QUEUED에 머무른다.
KAFKA_TOPIC_REPOSITORY_ANALYSIS_RESULTS=gitjob.repository-analysis.results.v1

# A조가 주차별 Weekly Repo Activity Snapshot 확정을 알리는 완료 이벤트 topic
# (S15P21E102-225). github.events Raw topic과 분리한다. partition 1 — 주차당 1건이고
# 순서가 유일한 의미다. payload는 dataset_snapshot_id / week_start / manifest_uri 3필드뿐이며
# selected_repo_count·coverage·기술별 Trend는 C조가 계산한다.
KAFKA_TOPIC_REPO_ACTIVITY_WEEKLY_COMPLETED=gitjob.repo-activity-weekly.completed.v1
ANALYSIS_CONSUMER_GROUP=gitjob-repository-analysis
# clone 최대 소요보다 커야 한다. 작으면 브로커가 파티션을 회수해 같은 저장소를 두 번 clone한다.
ANALYSIS_MAX_POLL_INTERVAL_MS=900000
ANALYSIS_CLONE_TIMEOUT_SECONDS=600
# CLONING 선점의 유효 기간. clone 최대 소요보다 커야 두 worker가 겹치지 않는다.
ANALYSIS_CLAIM_LEASE_SECONDS=900
# 일시 실패를 몇 번까지 재시도할지. 소진되면 영구 실패로 보고 DLQ로 보낸다.
ANALYSIS_MAX_ATTEMPTS=5
ANALYSIS_MAX_REPOSITORY_BYTES=2147483648
ANALYSIS_WORK_ROOT=/tmp/gitjob-analysis
# tree-sitter 파싱 한계. 인터넷에서 받아온 임의 저장소라 상한이 필요하다.
ANALYSIS_MAX_FILE_BYTES=1048576
ANALYSIS_MAX_FILES=50000
# 매니페스트 스캔 한계. 선언 파일은 작다 — 더 크면 생성된 것이거나 악의적이다.
ANALYSIS_MAX_MANIFEST_BYTES=524288
ANALYSIS_MAX_MANIFESTS=500
KAFKA_CONSUMER_GROUP=gitjob-analysis-worker
COLLECTOR_CONSUMER_GROUP=gitjob-collector
WORKER_CONSUMER_GROUP=gitjob-analysis-worker
KAFKA_SMOKE_TOPIC=gitjob.smoke

# -----------------------------------------------------------------------------
# HDFS/Spark data profile
# -----------------------------------------------------------------------------
HADOOP_CLUSTER_NAME=gitjob
HDFS_URI=hdfs://hdfs-namenode:8020
HDFS_REPLICATION_FACTOR=1
PARQUET_ROOT=hdfs:///gitjob/parquet

# C1 Archiver(Structured Streaming) 상시 실행 서비스 설정 (S15P21E102-228).
# spark-c1-archiver 서비스와 Infra/scripts/spark-c1-archiver.sh 가 같은 값을 쓴다.
# CHECKPOINT_ROOT 아래 {consumer}/{topic} 으로 나뉘므로 재시작이 중단 지점을 이어받는다.
# spark-c1-archiver 서비스와 Infra/scripts/spark-c1-archiver.sh 가 같은 이름을 읽는다.
# 예전 이름 TOPICS 도 스크립트에서 아직 읽히지만 새로 쓰지 않는다.
C1_TOPICS=github.events,so.raw
CHECKPOINT_ROOT=hdfs:///gitjob/checkpoints
MAX_OFFSETS_PER_TRIGGER=10000
RAW_ROOT=hdfs:///gitjob/raw
# A→C handover for job postings (S15P21E102-220). Raw keeps every run;
# this path keeps only the verified ones, one directory per run:
#   <root>/<source>/<RUN_ID>/{job_analysis_input.json,postings.csv,manifest.json}
# The GitHub side already publishes under analysis_input/github/repo_snapshot.
ANALYSIS_INPUT_JOBS_ROOT=hdfs:///gitjob/analysis_input/jobs
WEBHDFS_URL=http://hdfs-namenode:9870/webhdfs/v1
WEBHDFS_USER=hadoop
# Rewrites the DataNode host in the WebHDFS 307 redirect, for a run that is not
# on the cluster's Compose network. Leave empty on the data node itself: the
# container resolves `hdfs-datanode*` and no rewriting is wanted.
#
# A run off the network needs it, because the NameNode hands back the DataNode's
# own container hostname and the bytes move on that second hop. All three
# Single-host `compose.ec2-data.yaml` publishes the DataNode UIs on distinct
# host ports (9864/9866/9867). The two-host `compose.ec2-data-cluster.yaml`
# instead runs each DataNode on host networking with its own HTTP port, and
# 9866 there is DataNode-1's data-transfer socket, not a UI. Use the mapping
# that matches the overlay actually deployed:
#   single-host: hdfs-datanode:9864=<host>:9864,hdfs-datanode2:9864=<host>:9866,hdfs-datanode3:9864=<host>:9867
#   two-host:    <DATA_TS_IP>:9864=<DATA_TS_IP>:9864,<DATA_TS_IP>:9874=<DATA_TS_IP>:9874,<DATA_TS_IP>:9884=<DATA_TS_IP>:9884,<SERVICE_TS_IP>:9864=<SERVICE_TS_IP>:9864
WEBHDFS_DATANODE_HOSTS=
# C weekly Trend consumer. A's bounded exporter publishes immutable files below
# this host directory using public=<id>/snapshot=<id>/week=<Monday>.
C_WEEKLY_EXPORT_DIR=.local/c-weekly-exports
C_WEEKLY_HDFS_ROOT=hdfs:///gitjob/parquet/github/repo_activity_weekly
C_WEEKLY_INCLUDE_PARTIAL=false
WEEKLY_ACTIVITY_CONSUMER_GROUP=gitjob-weekly-trend
# Split production topology: the weekly Consumer runs on the Service host via
# compose.weekly-host.yaml. Use Tailscale addresses reachable from host network.
WEEKLY_CONSUMER_KAFKA_BOOTSTRAP=
WEEKLY_CONSUMER_KAFKA_AUTO_OFFSET_RESET=latest
WEEKLY_CONSUMER_GROUP=gitjob-weekly-trend-prod-v1
WEEKLY_CONSUMER_WEBHDFS_URL=
WEEKLY_CONSUMER_WEBHDFS_USER=hadoop
WEEKLY_CONSUMER_DATANODE_HOSTS=
WEEKLY_CONSUMER_POSTGRES_HOST=
WEEKLY_CONSUMER_POSTGRES_PORT=5432
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# -----------------------------------------------------------------------------
# Jenkins CI/CD profile
# -----------------------------------------------------------------------------
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-with-a-long-random-password
JENKINS_AGENT_NAME=docker-agent
# The inbound agent secret is issued by Jenkins for JENKINS_AGENT_NAME after
# the controller starts. Never generate or commit a replacement value here.
JENKINS_URL=http://localhost:8081
JENKINS_EC2_BIND=127.0.0.1
JENKINS_EC2_HTTP_PORT=8081
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false
DEPLOY_ENABLED=false

# Jenkins split deploy targets. GitLab pull credentials and the EC2 PEM stay in
# Jenkins Credentials or on the respective EC2 hosts. The remote runtime env
# files are never copied from this template.
EC2_DEPLOY_REF=develop
EC2_SERVICE_HOST=
EC2_SERVICE_USER=ubuntu
EC2_SERVICE_PATH=/home/ubuntu/workspace/S15P21E102
EC2_SERVICE_ENV_FILE=.env.service
EC2_DATA_HOST=
EC2_DATA_USER=ubuntu
EC2_DATA_PATH=/home/ubuntu/workspace/S15P21E102
EC2_DATA_ENV_FILE=.env.data
EC2_SSH_PORT=22
EC2_SSH_CREDENTIAL_ID=gitjob-ec2-ssh

# C internal compute API: generate a private random token (at least 32 chars).
# Empty means computation APIs are disabled; never expose this token to FE.
C_COMPUTE_TOKEN=
C_COMPUTE_URL=http://worker:8080
C_COMPUTE_PORT=8080
C_COMPUTE_LEASE_SECONDS=120
# Runtime Registry source. Import/activate an immutable DB snapshot explicitly.
# Same family selector as Backend; actual content version/hash is pinned separately.
C_REGISTRY_BACKEND=postgres
C_REGISTRY_VERSION=technology-registry/v1
# Local tests/offline tools only: opt into C_REGISTRY_BACKEND=file before using a path.
C_REGISTRY_PATH=
# Optional trusted, read-only local mirror for public repository artifacts.
# Configure a mount separately; no arbitrary request-supplied filesystem path.
C_ARTIFACT_ROOT=
C_ARTIFACT_URI_PREFIX=
# Optional read-only root for bounded GH Archive activity exports.
C_ARCHIVE_ACTIVITY_ROOT=
# Required with archive_version=v2. The staged A snapshot relative path is
# resolved below this immutable HDFS URI root and must match a_snapshot_uri.
C_ARCHIVE_A_SNAPSHOT_URI_ROOT=
# Optional c-intake-config/v1 JSON path inside Worker. Empty leaves Worker in its
# HTTP-only mode; set it to /config/c-intake.json once the file below exists.
# Public checkpoints stay writable; see docs/ai/c-compute-runtime.md.
C_INTAKE_CONFIG=
# Host directory mounted read-only at /config in Worker. Put c-intake.json here.
# Keep it out of Git: .local/ is ignored, the same place the Jenkins agent secret
# lives. A missing directory is not an error while C_INTAKE_CONFIG is empty.
C_INTAKE_CONFIG_DIR=.local/c-intake

# ----------------------------------------------------------------------------
# Technology summary (S15P21E102-256). The generator runs on the notebook, not
# here: it needs a GPU and this host has none. The two are joined over
# Tailscale, so this is a tailnet address, reachable from the service
# containers but not from the internet.
#
# Empty disables the call. A summary is a layer on top of a card that is already
# complete without it -- level, evidence and permalinks do not depend on it --
# so an unset or unreachable URL must degrade, never fail the request.
# See docs/infra/local-llm-runbook.md ch3.2 for how the link is brought up.
LLM_SUMMARY_BASE_URL=http://100.90.250.31:18080
# Generation is 3-8s warm and around a minute on a cold model load.
LLM_SUMMARY_TIMEOUT_SECONDS=120

AES_SYMMETRIC_KEY=64자리_랜덤_16진수
AES_SALT=32자리_랜덤_16진수
